{
  "name": "@4evergent/stellar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=75 --test-coverage-include=src/** --test-coverage-exclude=**/dist/** --test-coverage-exclude=**/test/** --test-coverage-exclude=**/__tests__/** --test-coverage-exclude=**/mocks/** --test-coverage-exclude=**/*.mock.ts --test-coverage-exclude=**/*.test-helper.ts test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@4evergent/shared": "workspace:*",
    "@4evergent/agent-core": "workspace:*",
    "@4evergent/policy": "workspace:*",
    "@4evergent/database": "workspace:*",
    "@stellar/stellar-sdk": "^13.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
