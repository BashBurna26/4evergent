{
  "name": "4evergent",
  "version": "0.1.0",
  "private": true,
  "description": "4evergent — Autonomous AI Agents on Stellar",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:watch": "pnpm --filter @4evergent/api dev",
    "test": "pnpm -r test",
    "test:coverage": "node scripts/test-coverage.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check:openapi": "node scripts/check-openapi.mjs",
    "verify": "echo '==> Build' && pnpm build && echo '==> Lint' && pnpm lint && echo '==> Typecheck' && pnpm typecheck && echo '==> Test' && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.0",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2"
  }
}
